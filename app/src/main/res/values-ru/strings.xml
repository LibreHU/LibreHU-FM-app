    <string name="set_antenna_power">Антенный усилитель</string>
    <string name="set_antenna_power_hint">Питание антенны (MCU 43), пока играет FM-радио, для активной антенны или антенного усилителя. Выкл.: пассивная антенна или более чистый приём FM без усилителя</string>
    <string name="set_history">Прослушанные песни</string>
